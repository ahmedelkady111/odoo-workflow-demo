# BLOCKING pylint pass — CI fails on any message here.
# Scope: real defects only (breakage, security, data loss, Odoo API misuse).
# Style and hygiene nits live in .pylintrc, which is advisory.
#
# Message list validated against pylint-odoo 10.0.11 — do not copy newer/older
# OCA lists in wholesale, many message names moved to OCA/odoo-pre-commit-hooks.

[MASTER]
load-plugins=pylint_odoo
score=n

[ODOOLINT]
valid-odoo-versions=19.0
manifest-required-keys=license
manifest-deprecated-keys=description,active
license-allowed=AGPL-3,GPL-3,LGPL-3,OEEL-1,Other proprietary

[MESSAGES CONTROL]
disable=all
enable=anomalous-backslash-in-string,
    assignment-from-none,
    dangerous-default-value,
    duplicate-key,
    eval-used,
    pointless-statement,
    redundant-keyword-arg,
    reimported,
    return-in-init,
    too-few-format-args,
    unreachable,
    attribute-deprecated,
    bad-builtin-groupby,
    consider-merging-classes-inherited,
    context-overridden,
    deprecated-name-get,
    deprecated-odoo-model-method,
    inheritable-method-lambda,
    inheritable-method-string,
    method-compute,
    method-inverse,
    method-required-super,
    method-search,
    missing-return,
    no-raise-unlink,
    no-search-all,
    no-wizard-in-models,
    no-write-in-compute,
    odoo-addons-relative-import,
    prohibited-method-override,
    renamed-field-parameter,
    super-method-mismatch,
    test-folder-imported,
    except-pass,
    external-request-timeout,
    invalid-commit,
    sql-injection,
    translation-contains-variable,
    translation-field,
    translation-injection,
    translation-positional-used,
    translation-required,
    license-allowed,
    manifest-data-duplicated,
    manifest-deprecated-key,
    manifest-required-key,
    manifest-version-format,
    resource-not-exist,
    website-manifest-key-not-valid-uri,
    print-used,
    use-vim-comment

[REPORTS]
msg-template={path}:{line}: [{msg_id}({symbol}), {obj}] {msg}
output-format=colorized
reports=no
